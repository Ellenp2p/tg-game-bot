BOT_TOKEN=123456:replace_me
# 群内 Mini App 按钮走 t.me 链接（Telegram 自家 Mini App 协议）；需要 BotFather /newapp 配置
# BOT_USERNAME=your_bot_name（不要带 @）
# APP_SHORT_NAME=game
# 私聊 Mini App 按钮走直接 HTTPS
PUBLIC_URL=https://example.com
PORT=3001
# SQLite 路径；不填默认 <repo>/data/bot.sqlite（相对仓库根，不再依赖启动目录）
DATA_FILE=./data/bot.sqlite
# 骰子动画等待毫秒（默认为 3500）
# DICE_ANIMATION_MS=3500
