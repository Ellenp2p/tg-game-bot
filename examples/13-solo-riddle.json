{
  "version": "1.6.0",
  "name": "单人谜语闯关",
  "description": "单人猜谜语，按对/错升级或继续。出题 5 题后结束。",
  "minPlayers": 1,
  "maxPlayers": 1,
  "rounds": [
    {
      "name": "谜语闯关",
      "loop": true,
      "maxLoops": 5,
      "steps": [
        {
          "type": "text",
          "label": "猜谜语",
          "prompt": "出题（不用打字，按 /next 直接进入下一题）：\n\n谜语 1：千条线，万条线，落入水里看不见。打一自然现象。\n答案：雨\n\n谜语 2：麻屋子，红帐子，里面睡着白胖子。打一食物。\n答案：花生\n\n谜语 3：远看山有色，近听水无声，春去花还在，人来鸟不惊。打一艺术形式。\n答案：画\n\n谜语 4：头戴红帽子，身穿白袍子，说话伸脖子，走路摆架子。打一动物。\n答案：鹅\n\n谜语 5：身穿绿衣服，肚里红彤彤，外表大麻子，心里水汪汪。打一水果。\n答案：西瓜"
        },
        {
          "type": "choice",
          "label": "答对了吗",
          "options": [
            { "text": "✅ 答对了！", "goto": "next" },
            { "text": "❌ 没答出来", "goto": { "roundIdx": 0, "stepIdx": 2 } }
          ]
        },
        {
          "type": "punish",
          "label": "没答出来？",
          "defaultText": "翻到下一题（再来一次）",
          "ladder": [
            { "at": 2, "text": "做 3 个俯卧撑" },
            { "at": 3, "text": "做 5 个俯卧撑" },
            { "at": 5, "text": "唱一首歌" }
          ]
        }
      ]
    }
  ]
}