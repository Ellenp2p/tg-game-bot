{
  "version": "1.6.0",
  "name": "骰子惩罚",
  "description": "单轮循环：每人轮流扔色子，按点数接受对应惩罚。逃避则升级。本规则跑 12 圈后结束。",
  "minPlayers": 2,
  "maxPlayers": 10,
  "rounds": [
    {
      "name": "惩罚轮（循环 12 圈）",
      "loop": true,
      "maxLoops": 12,
      "defaultEmoji": "🎲",
      "steps": [
        { "type": "roll", "label": "🎲 轮到下一位玩家扔色子", "assignment": "next_player" },
        {
          "type": "punish",
          "label": "按色子点数执行惩罚",
          "defaultText": "罚一杯",
          "ladder": [
            { "at": 1, "text": "🎲 1 点：讲一件尴尬事" },
            { "at": 2, "text": "🎲 2 点：模仿群里某个人" },
            { "at": 3, "text": "🎲 3 点：喝半杯" },
            { "at": 4, "text": "🎲 4 点：做 5 个俯卧撑" },
            { "at": 5, "text": "🎲 5 点：和右边的玩家干杯" },
            { "at": 6, "text": "🎲 6 点：指定下一个人喝两杯" }
          ]
        }
      ]
    }
  ]
}
