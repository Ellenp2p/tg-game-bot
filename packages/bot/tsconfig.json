{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "references": [{ "path": "../engine" }],
  "include": ["src/**/*.ts"]
}
